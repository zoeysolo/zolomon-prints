# Stripe — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe — Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Artelo — artelo.io account → API integration token
ARTELO_API_KEY=...

# Keep "true" until you've tested end-to-end. "false" sends real orders to production.
ARTELO_TEST_ORDERS=true

# Your deployed URL, e.g. https://zolomonprints.com (used for checkout redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
